# ─── App authentication (required for public deployments) ─────────────────
# Random secret for signing session cookies (32+ characters). REQUIRED in production.
# Generate: openssl rand -base64 48
REDSTONE_AUTH_SECRET=change_me_to_a_long_random_secret

# Optional overrides (defaults: guestuser / notageminiclone)
# REDSTONE_AUTH_USER=guestuser
# REDSTONE_AUTH_PASSWORD=notageminiclone
# REDSTONE_AUTH_PASSWORD_SALT=redstone-v1-fixed-salt-change-in-prod
# REDSTONE_AUTH_PASSWORD_HASH=base64_scrypt_hash_if_not_using_plain_password_env

# Ollama host used by the server-side proxy.
# For the Cloudflare tunnel:
OLLAMA_HOST=https://ollama.deoxylabs.com

# OLLAMA_API_KEY is the Bearer token required by Ollama when accessed
# via the Cloudflare tunnel. Set this on your deployment server so it
# never needs to be entered in the UI. Users can also set it at runtime
# via Settings in the app.
OLLAMA_API_KEY=your_api_key_here

# Brave Search API — used automatically before every model response.
# Get a key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your_brave_api_key_here
