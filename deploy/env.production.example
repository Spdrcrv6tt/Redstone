# Copy to .env.production on your WINDOWS PC (same machine as Ollama).
# Next.js loads this automatically when you run `npm run start`.

# Ollama is local on this PC — do NOT route through the public tunnel URL.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_API_KEY=your_ollama_bearer_token_if_required

BRAVE_SEARCH_API_KEY=your_brave_api_key

PORT=3000
